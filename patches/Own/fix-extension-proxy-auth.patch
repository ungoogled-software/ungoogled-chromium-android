description: Let extensions answer proxy logins on Android
author: bearinmindcat <bearincrypto@gmail.com>

VPN and proxy extensions answer a proxy's 407 challenge through
webRequest.onAuthRequired. The hand-off from the login flow to webRequest was only
built with full desktop extensions, so Android always showed the native sign-in
dialog instead of asking the extension.
---
diff --git a/chrome/browser/ui/login/BUILD.gn b/chrome/browser/ui/login/BUILD.gn
--- a/chrome/browser/ui/login/BUILD.gn
+++ b/chrome/browser/ui/login/BUILD.gn
@@ -4,6 +4,8 @@
 
 assert(is_win || is_mac || is_linux || is_chromeos || is_android)
 
+import("//extensions/buildflags/buildflags.gni")
+
 source_set("login") {
   sources = [
     "http_auth_coordinator.h",
@@ -52,6 +54,12 @@
       "//extensions/browser",
       "//extensions/common:mojom",
     ]
+  } else if (enable_extensions_core) {
+    deps += [
+      "//components/guest_view/browser",
+      "//extensions/browser",
+      "//extensions/common:mojom",
+    ]
   }
 
   public_deps = [ "//chrome/browser:browser_public_dependencies" ]
diff --git a/chrome/browser/ui/login/http_auth_coordinator.cc b/chrome/browser/ui/login/http_auth_coordinator.cc
--- a/chrome/browser/ui/login/http_auth_coordinator.cc
+++ b/chrome/browser/ui/login/http_auth_coordinator.cc
@@ -13,7 +13,7 @@
 #include "content/public/common/content_features.h"
 #include "extensions/buildflags/buildflags.h"
 
-#if BUILDFLAG(ENABLE_EXTENSIONS)
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
 #include "content/public/browser/guest_page_holder.h"
 #include "extensions/browser/api/web_request/web_request_api.h"  // nogncheck
 #include "extensions/browser/guest_view/web_view/web_view_guest.h"
@@ -109,7 +109,7 @@
 bool HttpAuthCoordinator::Flow::ForwardToExtension(
     content::GuestPageHolder* guest,
     content::BrowserContext* browser_context) {
-#if BUILDFLAG(ENABLE_EXTENSIONS)
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   // If the WebRequest API wants to take a shot at intercepting this, we can
   // return immediately. |continuation| will eventually be invoked if the
   // request isn't cancelled.
